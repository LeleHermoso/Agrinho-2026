* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background-color: white;
    color: #2e7d32;
    text-align: center;
}

header {
    background-color: #2e7d32;
    color: white;
    padding: 30px;
}

.banner {
    padding: 50px 20px;
    background-color: #e8f5e9;
}

.banner h2 {
    margin-bottom: 20px;
}

button {
    background-color: #2e7d32;
    color: white;
    border: none;
    padding: 12px 25px;
    border-radius: 8px;
    cursor: pointer;
    font-size: 16px;
}

button:hover {
    background-color: #1b5e20;
}

.conteudo {
    padding: 40px 20px;
}

.galeria {
    padding: 40px 20px;
    background-color: #f1f8f4;
}

.imagens {
    display: flex;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
}

.imagens img {
    width: 300px;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
    border: 4px solid #2e7d32;
}

footer {
    background-color: #2e7d32;
    color: white;
    padding: 15px;
    margin-top: 20px;
}